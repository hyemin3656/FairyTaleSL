              "견우",
              "직녀",
              "만나다",
              "사랑"
            ]
          }
        ]
      },
      {
        "segment_id": 2,
        "sentences": [
          {
            "text": "하느님은 두 사람을 은하수 양쪽으로 갈라놓았습니다.",
            "ksl_glosses": [
              "하느님",
              "은하수",
              "갈라놓다"
            ]
          },
          {
            "text": "직녀의 눈물이 비가 되어 세상에 내렸습니다.",
            "ksl_glosses": [
              "직녀",
              "눈물",
              "비",
              "세상"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "text": "하느님은 일 년에 한 번 칠월 칠석에만 만날 수 있도록 허락했습니다.",
            "ksl_glosses": [
              "하느님",
              "일년",
              "칠월칠석",
              "만나다",
              "허락"
            ]
          },
          {
            "text": "까치와 까마귀들이 다리를 놓아 두 사람이 만났습니다.",
            "ksl_glosses": [
              "까치",
              "까마귀",
              "다리",
              "놓다",
              "만나다"
            ]
          }
        ]
      }
    ]
  },
  {
    "tale_id": "장화홍련",
    "title": "장화홍련",
