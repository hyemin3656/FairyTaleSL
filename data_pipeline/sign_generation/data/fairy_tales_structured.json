    "target_age": "5-8",
    "segments": [
      {
        "segment_id": 1,
        "sentences": [
          {
            "text": "빨간 모자를 쓴 소녀가 할머니께 음식을 가져다드리러 숲 속으로 갔습니다.",
            "ksl_glosses": [
