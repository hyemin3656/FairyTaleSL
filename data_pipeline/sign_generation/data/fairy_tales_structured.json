              "장화",
              "홍련",
              "자매",
              "살다"
            ]
          },
          {
            "text": "어머니가 돌아가신 뒤 계모가 들어와 자매를 구박했습니다.",
            "ksl_glosses": [
              "어머니",
              "돌아가다",
              "계모",
              "구박"
