              "언니",
              "연못",
              "따르다"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "text": "용감한 부사가 진실을 밝혀 계모를 벌했습니다.",
            "ksl_glosses": [
              "부사",
              "진실",
              "밝히다",
              "계모",
              "벌"
            ]
          },
          {
            "text": "장화와 홍련은 다시 태어나 행복하게 살았습니다.",
            "ksl_glosses": [
              "장화",
              "홍련",
              "다시",
              "태어나다",
              "행복"
            ]
          }
        ]
      }
    ]
  },
  {
    "tale_id": "개미와_베짱이",
    "title": "개미와 베짱이",
    "category": "우화",
    "target_age": "5-8",
    "segments": [
      {
        "segment_id": 1,
        "sentences": [
          {
            "text": "여름 내내 개미는 열심히 먹이를 모았습니다.",
