              "늑대",
              "할머니",
              "침대",
              "기다리다"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "text": "빨간 모자는 이상함을 눈치채고 소리를 질렀습니다.",
            "ksl_glosses": [
              "빨간모자",
              "이상",
              "소리",
              "지르다"
            ]
          },
          {
            "text": "사냥꾼이 달려와 할머니와 빨간 모자를 구했습니다.",
            "ksl_glosses": [
              "사냥꾼",
