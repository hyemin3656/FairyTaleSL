              "개미",
              "먹다",
              "나누다",
              "부탁"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "text": "개미는 여름에 놀기만 했으니 스스로 책임져야 한다고 했습니다.",
            "ksl_glosses": [
              "개미",
              "여름",
              "놀다",
              "책임"
            ]
          },
          {
            "text": "베짱이는 게으름을 후회하며 다음에는 열심히 일하겠다고 다짐했습니다.",
            "ksl_glosses": [
              "베짱이",
