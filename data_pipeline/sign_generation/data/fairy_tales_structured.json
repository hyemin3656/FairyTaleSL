[
  {
    "tale_id": "토끼와_거북이",
    "title": "토끼와 거북이",
    "category": "동물",
    "target_age": "5-7",
    "segments": [
      {
        "segment_id": 1,
        "sentences": [
          {
            "sentence_id": 1,
            "text": "옛날 옛날에 토끼와 거북이가 살았습니다.",
            "ksl_glosses": [
              "옛날",
              "옛날",
              "토끼",
              "거북이"
            ]
          },
          {
            "sentence_id": 2,
            "text": "토끼가 거북이에게 달리기 시합을 하자고 했습니다.",
            "ksl_glosses": [
              "토끼",
              "거북이",
              "달리기",
              "시합"
            ]
          },
          {
            "sentence_id": 3,
            "text": "거북이는 느리지만 포기하지 않고 열심히 걸었습니다.",
            "ksl_glosses": [
              "거북이",
              "포기",
              "열심히",
              "느리"
            ]
          }
        ]
      },
      {
        "segment_id": 2,
        "sentences": [
          {
            "sentence_id": 4,
            "text": "토끼는 중간에 낮잠을 자다가 늦고 말았습니다.",
            "ksl_glosses": [
              "토끼",
              "중간",
              "낮잠"
            ]
          },
          {
            "sentence_id": 5,
            "text": "거북이가 먼저 결승선에 도착해서 이겼습니다.",
            "ksl_glosses": [
              "결승선",
              "거북이",
              "도착",
              "먼저",
              "이기"
            ]
          },
          {
            "sentence_id": 6,
            "text": "토끼는 자만하면 안 된다는 것을 배웠습니다.",
            "ksl_glosses": [
              "토끼",
              "자만",
              "배우"
            ]
          }
        ]
      }
    ]
  },
  {
    "tale_id": "흥부와_놀부",
    "title": "흥부와 놀부",
    "category": "전래민담",
    "target_age": "6-9",
    "segments": [
      {
        "segment_id": 1,
        "sentences": [
          {
            "sentence_id": 1,
            "text": "옛날에 흥부와 놀부 형제가 살았습니다.",
            "ksl_glosses": [
              "옛날",
              "흥부",
              "놀부",
              "형제"
            ]
          },
          {
            "sentence_id": 2,
            "text": "형 놀부는 욕심이 많고 마음이 나빴습니다.",
            "ksl_glosses": [
              "놀부",
              "욕심",
              "마음",
              "나쁘"
            ]
          },
          {
            "sentence_id": 3,
            "text": "동생 흥부는 착하고 가난하게 살았습니다.",
            "ksl_glosses": [
              "동생",
              "흥부",
              "가난",
              "착하"
            ]
          }
        ]
      },
      {
        "segment_id": 2,
        "sentences": [
          {
            "sentence_id": 4,
            "text": "흥부는 다리가 부러진 제비를 정성껏 고쳐 주었습니다.",
            "ksl_glosses": [
              "흥부",
              "다리",
              "제비",
              "정성껏",
              "부러지",
              "고치"
            ]
          },
          {
            "sentence_id": 5,
            "text": "제비가 봄에 돌아와 흥부에게 박씨를 물어다 주었습니다.",
            "ksl_glosses": [
              "제비",
              "흥부",
              "돌아오"
            ]
          },
          {
            "sentence_id": 6,
            "text": "흥부는 박씨를 심었고, 박에서 금은보화가 쏟아졌습니다.",
            "ksl_glosses": [
              "흥부",
              "금은보화",
              "쏟아지"
            ]
          },
          {
            "sentence_id": 7,
            "text": "흥부는 부자가 되어 행복하게 살았습니다.",
            "ksl_glosses": [
              "흥부",
              "부자",
              "행복"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "sentence_id": 8,
            "text": "욕심 많은 놀부도 제비 다리를 일부러 부러뜨렸습니다.",
            "ksl_glosses": [
              "욕심",
              "놀부",
              "제비",
              "다리",
              "일부러",
              "부러뜨리"
            ]
          },
          {
            "sentence_id": 9,
            "text": "놀부의 박에서는 도깨비와 오물이 쏟아져 나왔습니다.",
            "ksl_glosses": [
              "놀부",
              "도깨비",
              "오물",
              "쏟아지",
              "나오"
            ]
          },
          {
            "sentence_id": 10,
            "text": "놀부는 재산을 모두 잃고 후회하였습니다.",
            "ksl_glosses": [
              "놀부",
              "재산",
              "후회",
              "모두"
            ]
          },
          {
            "sentence_id": 11,
            "text": "흥부는 형 놀부를 용서하고 함께 살았습니다.",
            "ksl_glosses": [
              "흥부",
              "놀부",
              "용서",
              "함께"
            ]
          }
        ]
      }
    ]
  },
  {
    "tale_id": "콩쥐팥쥐",
    "title": "콩쥐팥쥐",
    "category": "전래민담",
    "target_age": "6-9",
    "segments": [
      {
        "segment_id": 1,
        "sentences": [
          {
            "sentence_id": 1,
            "text": "옛날에 콩쥐라는 착한 소녀가 살았습니다.",
            "ksl_glosses": [
              "옛날",
              "콩쥐",
              "소녀",
              "착하"
            ]
          },
          {
            "sentence_id": 2,
            "text": "콩쥐의 어머니는 일찍 돌아가셨습니다.",
            "ksl_glosses": [
              "콩쥐",
              "어머니",
              "일찍",
              "돌아가시"
            ]
          },
          {
            "sentence_id": 3,
            "text": "아버지가 새 어머니를 데려왔는데, 팥쥐 어머니였습니다.",
            "ksl_glosses": [
              "아버지",
              "어머니",
              "팥쥐",
              "어머니",
              "데려오"
            ]
          },
          {
            "sentence_id": 4,
            "text": "새 어머니와 팥쥐는 콩쥐를 미워하고 힘든 일만 시켰습니다.",
            "ksl_glosses": [
              "어머니",
              "팥쥐",
              "콩쥐",
              "미워하",
              "시키",
              "힘들"
            ]
          }
        ]
      },
      {
        "segment_id": 2,
        "sentences": [
          {
            "sentence_id": 5,
            "text": "콩쥐는 힘든 상황에서도 열심히 일하고 착하게 지냈습니다.",
            "ksl_glosses": [
              "콩쥐",
              "상황",
              "열심히",
              "지내",
              "힘들",
              "착하"
            ]
          },
          {
            "sentence_id": 6,
            "text": "어느 날 마을에서 큰 잔치가 열렸습니다.",
            "ksl_glosses": [
              "마을",
              "잔치",
              "열리"
            ]
          },
          {
            "sentence_id": 7,
            "text": "새 어머니는 콩쥐에게 불가능한 일을 시키고 먼저 떠났습니다.",
            "ksl_glosses": [
              "어머니",
              "콩쥐",
              "가능",
              "먼저",
              "시키",
              "떠나"
            ]
          },
          {
            "sentence_id": 8,
            "text": "선한 동물들이 나타나 콩쥐를 도와 일을 마치게 해 주었습니다.",
            "ksl_glosses": [
              "동물",
              "콩쥐",
              "나타나",
              "마치"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "sentence_id": 9,
            "text": "콩쥐는 잔치에서 원님을 만나 사랑받게 되었습니다.",
            "ksl_glosses": [
              "콩쥐",
              "잔치",
              "사랑",
              "만나"
            ]
          },
          {
            "sentence_id": 10,
            "text": "팥쥐는 콩쥐를 시기하여 나쁜 마음을 품었습니다.",
            "ksl_glosses": [
              "팥쥐",
              "콩쥐",
              "시기",
              "마음",
              "나쁘"
            ]
          },
          {
            "sentence_id": 11,
            "text": "결국 나쁜 마음을 가진 팥쥐는 벌을 받게 되었습니다.",
            "ksl_glosses": [
              "결국",
              "마음",
              "팥쥐",
              "가지",
              "나쁘"
            ]
          },
          {
            "sentence_id": 12,
            "text": "착하고 성실한 사람은 반드시 행복해진다는 이야기입니다.",
            "ksl_glosses": [
              "성실",
              "사람",
              "행복",
              "이야기",
              "반드시",
              "착하"
            ]
          }
        ]
      }
    ]
  },
  {
    "tale_id": "금도끼_은도끼",
    "title": "금도끼 은도끼",
    "category": "전래민담",
    "target_age": "5-8",
    "segments": [
      {
        "segment_id": 1,
        "sentences": [
          {
            "sentence_id": 1,
            "text": "옛날에 나무꾼이 나무를 하러 산에 갔습니다.",
            "ksl_glosses": [
              "옛날",
              "나무",
              "나무"
            ]
          },
          {
            "sentence_id": 2,
            "text": "나무꾼이 나무를 하다가 도끼를 연못에 빠뜨렸습니다.",
            "ksl_glosses": [
              "나무",
              "나무",
              "연못",
              "도끼",
              "빠뜨리"
            ]
          },
          {
            "sentence_id": 3,
            "text": "나무꾼은 슬퍼서 연못가에서 울었습니다.",
            "ksl_glosses": [
              "나무",
              "연못가",
              "슬프"
            ]
          },
          {
            "sentence_id": 4,
            "text": "그때 산신령이 나타나 금도끼를 보여 주었습니다.",
            "ksl_glosses": [
              "그때",
              "산신령",
              "금도끼",
              "나타나",
              "보이"
            ]
          }
        ]
      },
      {
        "segment_id": 2,
        "sentences": [
          {
            "sentence_id": 5,
            "text": "나무꾼은 자신의 도끼가 아니라고 솔직하게 말했습니다.",
            "ksl_glosses": [
              "나무",
              "자신",
              "도끼"
            ]
          },
          {
            "sentence_id": 6,
            "text": "산신령이 은도끼를 보여 주었지만 나무꾼은 또 아니라고 했습니다.",
            "ksl_glosses": [
              "나무",
              "산신령",
              "도끼",
              "보이"
            ]
          },
          {
            "sentence_id": 7,
            "text": "마지막으로 낡은 쇠도끼를 보여 주자 나무꾼은 자기 것이라 했습니다.",
            "ksl_glosses": [
              "마지막",
              "나무",
              "쇠도끼",
              "보이"
            ]
          },
          {
            "sentence_id": 8,
            "text": "산신령은 나무꾼의 정직함을 칭찬하며 세 도끼를 모두 주었습니다.",
            "ksl_glosses": [
              "나무",
              "산신령",
              "정직",
              "칭찬",
              "도끼",
              "모두"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "sentence_id": 9,
            "text": "이 소식을 들은 욕심 많은 나무꾼이 일부러 도끼를 빠뜨렸습니다.",
            "ksl_glosses": [
              "나무",
              "소식",
              "욕심",
              "도끼",
              "일부러",
              "빠뜨리"
            ]
          },
          {
            "sentence_id": 10,
            "text": "산신령이 금도끼를 보이자 욕심쟁이 나무꾼은 자기 것이라 거짓말했습니다.",
            "ksl_glosses": [
              "나무",
              "산신령",
              "금도끼",
              "욕심",
              "거짓말",
              "보이"
            ]
          },
          {
            "sentence_id": 11,
            "text": "산신령은 화를 내며 도끼를 하나도 주지 않았습니다.",
            "ksl_glosses": [
              "산신령",
              "도끼"
            ]
          },
          {
            "sentence_id": 12,
            "text": "거짓말과 욕심은 결국 손해를 가져온다는 교훈입니다.",
            "ksl_glosses": [
              "거짓말",
              "욕심",
              "손해",
              "교훈",
              "결국",
              "가져오"
            ]
          }
        ]
      }
    ]
  },
  {
    "tale_id": "심청전",
    "title": "심청전",
    "category": "전래민담",
    "target_age": "7-10",
    "segments": [
      {
        "segment_id": 1,
        "sentences": [
          {
            "sentence_id": 1,
            "text": "옛날에 심학규라는 눈먼 아버지와 심청이라는 딸이 살았습니다.",
            "ksl_glosses": [
              "옛날",
              "심학규",
              "아버지",
              "심청이",
              "눈멀"
            ]
          },
          {
            "sentence_id": 2,
            "text": "심청이는 아버지를 위해 무엇이든 하려고 했습니다.",
            "ksl_glosses": [
              "심청이",
              "아버지",
              "위하"
            ]
          },
          {
            "sentence_id": 3,
            "text": "공양미 삼백 석을 바치면 눈을 뜰 수 있다는 말을 들었습니다.",
            "ksl_glosses": [
              "공양미",
              "바치"
            ]
          },
          {
            "sentence_id": 4,
            "text": "심청이는 뱃사람들에게 공양미 삼백 석을 받고 인당수에 몸을 던졌습니다.",
            "ksl_glosses": [
              "심청이",
              "뱃사람",
              "공양미",
              "인당수",
              "던지"
            ]
          }
        ]
      },
      {
        "segment_id": 2,
        "sentences": [
          {
            "sentence_id": 5,
            "text": "심청이의 효심이 하늘을 감동시켰습니다.",
            "ksl_glosses": [
              "하늘",
              "심청이",
              "효심",
              "감동"
            ]
          },
          {
            "sentence_id": 6,
            "text": "용왕이 심청이를 연꽃 속에 넣어 세상으로 돌려보냈습니다.",
            "ksl_glosses": [
              "세상",
              "용왕",
              "심청이",
              "연꽃",
              "돌려보내"
            ]
          },
          {
            "sentence_id": 7,
            "text": "연꽃은 바다 위를 떠다니다가 임금님께 발견되었습니다.",
            "ksl_glosses": [
              "바다",
              "연꽃",
              "임금",
              "발견",
              "떠다니"
            ]
          },
          {
            "sentence_id": 8,
            "text": "임금님은 심청이를 왕비로 맞이하였습니다.",
            "ksl_glosses": [
              "임금",
              "심청이",
              "왕비"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "sentence_id": 9,
            "text": "심청이는 왕비가 된 후에도 눈먼 아버지를 그리워했습니다.",
            "ksl_glosses": [
              "심청이",
              "왕비",
              "아버지",
              "눈멀",
              "그리워하"
            ]
          },
          {
            "sentence_id": 10,
            "text": "심청이는 전국의 눈먼 사람들을 위해 잔치를 열었습니다.",
            "ksl_glosses": [
              "심청이",
              "전국",
              "사람",
              "잔치",
              "눈멀",
              "위하"
            ]
          },
          {
            "sentence_id": 11,
            "text": "잔치에 나타난 아버지 심학규는 딸을 만나 눈을 떴습니다.",
            "ksl_glosses": [
              "잔치",
              "아버지",
              "심학규",
              "나타나",
              "만나"
            ]
          },
          {
            "sentence_id": 12,
            "text": "효도와 희생이 기적을 만들어 낸다는 아름다운 이야기입니다.",
            "ksl_glosses": [
              "효도",
              "희생",
              "기적",
              "이야기",
              "만들"
            ]
          }
        ]
      }
    ]
  },
  {
    "tale_id": "단군신화",
    "title": "단군신화",
    "category": "신화",
    "target_age": "8-11",
    "segments": [
      {
        "segment_id": 1,
        "sentences": [
          {
            "sentence_id": 1,
            "text": "아주 먼 옛날 하늘나라에 환인이라는 신이 살았습니다.",
            "ksl_glosses": [
              "옛날",
              "하늘",
              "나라",
              "환인",
              "아주"
            ]
          },
          {
            "sentence_id": 2,
            "text": "환인의 아들 환웅은 인간 세상에 내려가고 싶었습니다.",
            "ksl_glosses": [
              "세상",
              "환인",
              "아들",
              "환웅",
              "인간",
              "내리"
            ]
          },
          {
            "sentence_id": 3,
            "text": "환웅은 무리 삼천 명을 이끌고 태백산 꼭대기에 내려왔습니다.",
            "ksl_glosses": [
              "환웅",
              "무리",
              "태백산",
              "꼭대기",
              "이끌",
              "내려오"
            ]
          },
          {
            "sentence_id": 4,
            "text": "환웅은 풍백, 우사, 운사를 거느리고 세상을 다스렸습니다.",
            "ksl_glosses": [
              "세상",
              "환웅",
              "우사",
              "운사",
              "거느리",
              "다스리"
            ]
          }
        ]
      },
      {
        "segment_id": 2,
        "sentences": [
          {
            "sentence_id": 5,
            "text": "어느 날 곰과 호랑이가 환웅을 찾아와 사람이 되고 싶다고 했습니다.",
            "ksl_glosses": [
              "호랑이",
              "환웅",
              "사람",
              "찾아오"
            ]
          },
          {
            "sentence_id": 6,
            "text": "환웅은 쑥과 마늘만 먹으며 백 일 동안 굴에서 지내라고 했습니다.",
            "ksl_glosses": [
              "환웅",
              "마늘",
              "동안",
              "지내"
            ]
          },
          {
            "sentence_id": 7,
            "text": "호랑이는 참지 못하고 굴을 나왔지만 곰은 끝까지 참았습니다.",
            "ksl_glosses": [
              "호랑이",
              "나오"
            ]
          },
          {
            "sentence_id": 8,
            "text": "곰은 여자 사람인 웅녀가 되었습니다.",
            "ksl_glosses": [
              "여자",
              "사람",
              "웅녀"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "sentence_id": 9,
            "text": "환웅과 웅녀 사이에서 단군왕검이 태어났습니다.",
            "ksl_glosses": [
              "환웅",
              "웅녀",
              "사이",
              "단군왕검",
              "태어나"
            ]
          },
          {
            "sentence_id": 10,
            "text": "단군왕검은 나라를 세우고 고조선이라 불렀습니다.",
            "ksl_glosses": [
              "단군왕검",
              "나라",
              "고조선",
              "세우",
              "부르"
            ]
          },
          {
            "sentence_id": 11,
            "text": "단군왕검은 오래도록 백성을 잘 다스렸습니다.",
            "ksl_glosses": [
              "단군왕검",
              "백성",
              "오래도록",
              "다스리"
            ]
          },
          {
            "sentence_id": 12,
            "text": "이것이 우리나라 최초의 나라 고조선의 시작입니다.",
            "ksl_glosses": [
              "우리나라",
              "최초",
              "나라",
              "고조선",
              "시작"
            ]
          }
        ]
      }
    ]
  },
  {
    "tale_id": "선녀와_나무꾼",
    "title": "선녀와 나무꾼",
    "category": "전래민담",
    "target_age": "6-9",
    "segments": [
      {
        "segment_id": 1,
        "sentences": [
          {
            "sentence_id": 1,
            "text": "옛날에 가난한 나무꾼이 산에서 나무를 하며 살았습니다.",
            "ksl_glosses": [
              "옛날",
              "나무",
              "나무",
              "가난"
            ]
          },
          {
            "sentence_id": 2,
            "text": "어느 날 사냥꾼에게 쫓기는 사슴 한 마리를 구해 주었습니다.",
            "ksl_glosses": [
              "사냥",
              "사슴",
              "쫓기",
              "구하"
            ]
          },
          {
            "sentence_id": 3,
            "text": "사슴은 나무꾼에게 선녀들이 목욕하는 연못을 알려 주었습니다.",
            "ksl_glosses": [
              "나무",
              "연못",
              "사슴",
              "선녀",
              "목욕",
              "알리"
            ]
          },
          {
            "sentence_id": 4,
            "text": "사슴은 선녀의 날개옷을 숨기라고 일러 주었습니다.",
            "ksl_glosses": [
              "사슴",
              "선녀",
              "날개",
              "숨기"
            ]
          }
        ]
      },
      {
        "segment_id": 2,
        "sentences": [
          {
            "sentence_id": 5,
            "text": "나무꾼은 날개옷을 잃은 선녀와 결혼하여 행복하게 살았습니다.",
            "ksl_glosses": [
              "나무",
              "날개옷",
              "선녀",
              "결혼",
              "행복"
            ]
          },
          {
            "sentence_id": 6,
            "text": "아이를 셋 낳기 전에는 날개옷을 돌려주지 말라고 했습니다.",
            "ksl_glosses": [
              "아이",
              "날개옷",
              "돌려주"
            ]
          },
          {
            "sentence_id": 7,
            "text": "나무꾼은 아이 둘을 낳은 후 선녀에게 날개옷을 주고 말았습니다.",
            "ksl_glosses": [
              "나무",
              "아이",
              "선녀",
              "날개옷"
            ]
          },
          {
            "sentence_id": 8,
            "text": "선녀는 아이들을 안고 하늘로 올라가 버렸습니다.",
            "ksl_glosses": [
              "하늘",
              "선녀",
              "아이",
              "올라가"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "sentence_id": 9,
            "text": "나무꾼은 슬퍼하며 그리워했습니다.",
            "ksl_glosses": [
              "나무",
              "슬퍼하",
              "그리워하"
            ]
          },
          {
            "sentence_id": 10,
            "text": "사슴이 나타나 하늘로 올라가는 두레박 비결을 알려 주었습니다.",
            "ksl_glosses": [
              "하늘",
              "사슴",
              "두레박",
              "비결",
              "나타나",
              "올라가",
              "알리"
            ]
          },
          {
            "sentence_id": 11,
            "text": "나무꾼은 두레박을 타고 하늘에 올라가 가족과 만났습니다.",
            "ksl_glosses": [
              "나무",
              "하늘",
              "두레박",
              "가족",
              "올라가",
              "만나"
            ]
          },
          {
            "sentence_id": 12,
            "text": "나무꾼은 하늘에서 살다가 어머니가 그리워졌습니다.",
            "ksl_glosses": [
              "나무",
              "하늘",
              "어머니"
            ]
          },
          {
            "sentence_id": 13,
            "text": "용마를 타고 잠시 지상에 내려왔다가 실수로 말에서 떨어졌습니다.",
            "ksl_glosses": [
              "용마",
              "지상",
              "실수",
              "잠시",
              "내려오",
              "떨어지"
            ]
          },
          {
            "sentence_id": 14,
            "text": "나무꾼은 결국 수탉이 되어 하늘을 그리워하며 울었다고 합니다.",
            "ksl_glosses": [
              "결국",
              "나무",
              "하늘",
              "수탉",
              "그리워하"
            ]
          }
        ]
      }
    ]
  },
  {
    "tale_id": "해님달님",
    "title": "해님달님",
    "category": "전래민담",
    "target_age": "5-8",
    "segments": [
      {
        "segment_id": 1,
        "sentences": [
          {
            "sentence_id": 1,
            "text": "옛날에 홀어머니와 남매가 함께 살았습니다.",
            "ksl_glosses": [
              "옛날",
              "홀어머니",
              "남매",
              "함께"
            ]
          },
          {
            "sentence_id": 2,
            "text": "어머니는 장에 나가 떡을 팔아 생계를 이어갔습니다.",
            "ksl_glosses": [
              "어머니",
              "생계",
              "나가"
            ]
          },
          {
            "sentence_id": 3,
            "text": "어느 날 어머니가 장에서 돌아오는 길에 호랑이를 만났습니다.",
            "ksl_glosses": [
              "어머니",
              "호랑이",
              "돌아오",
              "만나"
            ]
          },
          {
            "sentence_id": 4,
            "text": "호랑이는 떡을 하나씩 달라고 협박했습니다.",
            "ksl_glosses": [
              "호랑이",
              "협박"
            ]
          },
          {
            "sentence_id": 5,
            "text": "어머니는 호랑이에게 떡을 모두 빼앗기고 말았습니다.",
            "ksl_glosses": [
              "어머니",
              "호랑이",
              "모두",
              "빼앗기"
            ]
          }
        ]
      },
      {
        "segment_id": 2,
        "sentences": [
          {
            "sentence_id": 6,
            "text": "호랑이는 떡을 다 먹고도 어머니를 잡아먹었습니다.",
            "ksl_glosses": [
              "호랑이",
              "어머니",
              "잡아먹"
            ]
          },
          {
            "sentence_id": 7,
            "text": "호랑이는 어머니로 변장하여 아이들을 찾아갔습니다.",
            "ksl_glosses": [
              "호랑이",
              "어머니",
              "변장",
              "아이",
              "찾아가"
            ]
          },
          {
            "sentence_id": 8,
            "text": "오누이는 이상함을 느끼고 문을 열어 주지 않았습니다.",
            "ksl_glosses": [
              "오누이",
              "이상",
              "느끼"
            ]
          },
          {
            "sentence_id": 9,
            "text": "호랑이가 손을 내밀자 오누이는 털이 많다며 의심했습니다.",
            "ksl_glosses": [
              "호랑이",
              "오누이",
              "의심",
              "내밀"
            ]
          },
          {
            "sentence_id": 10,
            "text": "호랑이는 밀가루를 바르고 다시 손을 내밀었습니다.",
            "ksl_glosses": [
              "호랑이",
              "밀가루",
              "다시",
              "바르",
              "내밀"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "sentence_id": 11,
            "text": "결국 오누이는 문을 열었고 호랑이를 보고 놀라 도망쳤습니다.",
            "ksl_glosses": [
              "결국",
              "오누이",
              "호랑이",
              "놀라",
              "도망치"
            ]
          },
          {
            "sentence_id": 12,
            "text": "오누이는 나무 위로 올라가 하늘에 기도했습니다.",
            "ksl_glosses": [
              "나무",
              "하늘",
              "오누이",
              "기도",
              "올라가"
            ]
          },
          {
            "sentence_id": 13,
            "text": "하늘에서 튼튼한 동아줄이 내려왔습니다.",
            "ksl_glosses": [
              "하늘",
              "동아줄",
              "내려오"
            ]
          },
          {
            "sentence_id": 14,
            "text": "오누이는 동아줄을 잡고 하늘로 올라갔습니다.",
            "ksl_glosses": [
              "하늘",
              "오누이",
              "동아줄",
              "올라가"
            ]
          },
          {
            "sentence_id": 15,
            "text": "호랑이도 동아줄을 달라고 빌었지만 썩은 동아줄이 내려왔습니다.",
            "ksl_glosses": [
              "호랑이",
              "동아줄",
              "동아줄",
              "내려오"
            ]
          }
        ]
      },
      {
        "segment_id": 4,
        "sentences": [
          {
            "sentence_id": 16,
            "text": "호랑이는 올라가다 동아줄이 끊어져 수수밭에 떨어졌습니다.",
            "ksl_glosses": [
              "호랑이",
              "동아줄",
              "수수",
              "올라가",
              "끊어지",
              "떨어지"
            ]
          },
          {
            "sentence_id": 17,
            "text": "그래서 수수대가 붉은색이 되었다고 합니다.",
            "ksl_glosses": [
              "수수대",
              "붉은색"
            ]
          },
          {
            "sentence_id": 18,
            "text": "하늘로 올라간 오빠는 해님이 되고, 누이는 달님이 되었습니다.",
            "ksl_glosses": [
              "하늘",
              "오빠",
              "누이",
              "올라가"
            ]
          },
          {
            "sentence_id": 19,
            "text": "해님달님은 온 세상을 밝게 비추며 살아갔습니다.",
            "ksl_glosses": [
              "세상",
              "비추",
              "살아가"
            ]
          },
          {
            "sentence_id": 20,
            "text": "착한 마음과 믿음이 기적을 만들어 낸다는 이야기입니다.",
            "ksl_glosses": [
              "마음",
              "믿음",
              "기적",
              "이야기",
              "만들",
              "착하"
            ]
          }
        ]
      }
    ]
  },
  {
    "tale_id": "팥죽할머니와_호랑이",
    "title": "팥죽할머니와 호랑이",
    "category": "전래동화",
    "target_age": "5-8",
    "segments": [
      {
        "segment_id": 1,
        "sentences": [
          {
            "sentence_id": 1,
            "text": "옛날에 혼자 사는 할머니가 있었습니다.",
            "ksl_glosses": [
              "옛날",
              "혼자",
              "할머니"
            ]
          },
          {
            "sentence_id": 2,
            "text": "할머니는 팥죽을 끓이러 산에 팥을 따러 갔습니다.",
            "ksl_glosses": [
              "산",
              "할머니",
              "팥죽",
              "끓이"
            ]
          },
          {
            "sentence_id": 3,
            "text": "그때 호랑이가 나타나 할머니를 잡아먹으려 했습니다.",
            "ksl_glosses": [
              "그때",
              "호랑이",
              "할머니",
              "나타나",
              "잡아먹"
            ]
          }
        ]
      },
      {
        "segment_id": 2,
        "sentences": [
          {
            "sentence_id": 4,
            "text": "할머니는 팥죽을 나눠 주겠다고 약속하며 위기를 넘겼습니다.",
            "ksl_glosses": [
              "할머니",
              "팥죽",
              "약속",
              "위기",
              "나누",
              "넘기"
            ]
          },
          {
            "sentence_id": 5,
            "text": "집에 돌아온 할머니는 팥죽을 끓였습니다.",
            "ksl_glosses": [
              "할머니",
              "팥죽",
              "돌아오",
              "끓이"
            ]
          },
          {
            "sentence_id": 6,
            "text": "알밤, 송곳, 맷돌, 지게, 소 등 친구들이 모여 호랑이를 기다렸습니다.",
            "ksl_glosses": [
              "알밤",
              "송곳",
              "맷돌",
              "지게",
              "친구",
              "호랑이",
              "모이",
              "기다리"
            ]
          }
        ]
      },
      {
        "segment_id": 3,
        "sentences": [
          {
            "sentence_id": 7,
            "text": "밤에 호랑이가 나타났습니다.",
            "ksl_glosses": [
              "호랑이",
              "나타나"
            ]
          },
          {
            "sentence_id": 8,
            "text": "알밤이 호랑이 눈을 때리고, 송곳이 발을 찌르고, 맷돌이 등을 눌렀습니다.",
            "ksl_glosses": [
              "알밤",
              "호랑이",
              "송곳",
              "맷돌",
              "때리",
              "찌르",
              "누르"
            ]
          },
          {
            "sentence_id": 9,
            "text": "호랑이는 혼비백산 도망쳤습니다.",
            "ksl_glosses": [
              "호랑이",
              "도망치"
            ]
          },
          {
            "sentence_id": 10,
            "text": "할머니는 친구들과 함께 팥죽을 맛있게 먹었습니다.",
            "ksl_glosses": [
              "할머니",
              "친구",
              "팥죽",
              "함께",
              "맛있"
            ]
          }
        ]
      }
    ]
  },
  {
