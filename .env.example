# ── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=psycho
POSTGRES_PASSWORD=changeme
POSTGRES_DB=psycho_db
DATABASE_URL=postgresql+asyncpg://psycho:changeme@postgres:5432/psycho_db

# ── JWT ─────────────────────────────────────────────
SECRET_KEY=replace-with-32-byte-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM ─────────────────────────────────────────────
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# ── AI Engine ───────────────────────────────────────
AI_ENGINE_URL=http://ai_engine:8001
MODEL_WEIGHTS_DIR=/app/weights

# ── SMTP (비밀번호 찾기) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── App ─────────────────────────────────────────────
APP_ENV=development
